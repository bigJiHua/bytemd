{
  "name": "@bytemd/monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "scripts": {
    "build": "pnpm clean && node scripts/build.mjs && tsc --build",
    "clean": "node scripts/clean.mjs",
    "dev": "pnpm --filter playground dev",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,md,svelte}\" && sort-package-json package.json \"packages/*/package.json\"",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "pub": "pnpm generate && pnpm generate:check && pnpm build && pnpm -r publish --no-git-checks",
    "style": "prettier --check \"**/*.{ts,tsx,mjs,json,md,svelte}\"",
    "test": "vitest",
    "test:scripts": "node --test scripts/test/generate.test.mjs scripts/test/prod-perf.test.mjs scripts/test/hygiene.test.mjs",
    "test:scripts:coverage": "c8 --all --include=\"scripts/generate.mjs\" --include=\"audit/prod-perf-cdp-client.mjs\" --include=\"audit/prod-perf-archiver.mjs\" --include=\"audit/prod-perf-summarize.mjs\" --reports-dir=audit/prod-perf-script-coverage --reporter=text --reporter=json-summary --check-coverage --lines=80 --statements=80 --branches=80 --functions=75 node --test scripts/test/generate.test.mjs scripts/test/prod-perf.test.mjs scripts/test/hygiene.test.mjs"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-svelte",
      "@trivago/prettier-plugin-sort-imports"
    ],
    "proseWrap": "never",
    "semi": false,
    "singleQuote": true
  },
  "devDependencies": {
    "@icon-park/svg": "^1.4.2",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/svelte": "^5.4.2",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/fs-extra": "^11.0.1",
    "@types/lodash-es": "^4.17.7",
    "@types/resolve": "^1.20.2",
    "bundlewatch": "^0.3.3",
    "c8": "^12.0.0",
    "decode-named-character-reference": "^1.0.2",
    "execa": "^7.1.1",
    "fast-glob": "^3.2.12",
    "fs-extra": "^11.1.1",
    "jsdom": "^24.1.3",
    "lodash-es": "^4.17.21",
    "mustache": "^4.2.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.3.3",
    "resolve": "^1.22.1",
    "sass": "^1.60.0",
    "sort-package-json": "^2.4.1",
    "svelte": "^5.0.0",
    "svelte-preprocess": "^6.0.5",
    "svelte2tsx": "^0.7.62",
    "svgo": "^3.0.2",
    "typescript": "^5.0.2",
    "vite": "^5.4.20",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@8.15.9+sha512.499434c9d8fdd1a2794ebf4552b3b25c0a633abcee5bb15e7b5de90f32f47b513aca98cd5cfd001c31f0db454bc3804edccd578501e4ca293a6816166bbd9f81",
  "engines": {
    "node": ">=20"
  },
  "bundlewatch": {
    "files": [
      {
        "path": "packages/bytemd/dist/index.mjs",
        "maxSize": "210 kB"
      },
      {
        "path": "packages/bytemd/dist/index.css",
        "maxSize": "30 kB"
      },
      {
        "path": "packages/bytemd/dist/markdown.css",
        "maxSize": "25 kB"
      }
    ],
    "ci": {
      "repoBranchBase": "main",
      "trackBranches": [
        "main"
      ]
    }
  },
  "pnpm": {
    "overrides": {
      "lodash-es": "^4.18.1",
      "braces@^3.0.0": "^3.0.3",
      "minimatch@^3.0.0": "^3.1.5",
      "brace-expansion@^1.0.0": "^1.1.21",
      "nanoid@^3.0.0": "^3.3.20",
      "picomatch@^2.0.0": "^2.3.2",
      "micromatch@^4.0.0": "^4.0.8",
      "postcss@^8.0.0": "^8.5.31",
      "rollup@^3.0.0": "^3.30.0",
      "immutable@^4.0.0": "^4.3.9",
      "source-map-js@^1.0.0": "^1.2.2",
      "form-data@^4.0.0": "^4.0.6",
      "@babel/traverse@^7.0.0": "^7.23.2",
      "rehype-katex@^7.0.0>katex": "0.16.47",
      "micromark-extension-math@^3.0.0>katex": "0.16.47",
      "bundlewatch>axios": "^1.7.9",
      "cross-spawn@^7.0.0": "^7.0.5",
      "tinypool@^1.0.0": "2.1.2"
    }
  }
}
