{
  "name": "@bytemd/vue-next",
  "version": "1.22.0",
  "description": "Hackable Markdown Editor and Viewer",
  "repository": {
    "type": "git",
    "url": "https://github.com/bigJiHua/bytemd.git",
    "directory": "packages/vue-next"
  },
  "license": "MIT",
  "author": "Rongjian Zhang",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./locales/*": "./locales/*",
    "./lib/locales/*": "./locales/*",
    "./async": {
      "types": "./dist/async.d.ts",
      "import": "./dist/async.mjs",
      "require": "./dist/async.js"
    },
    "./viewer": {
      "types": "./dist/viewer.d.ts",
      "import": "./dist/viewer.mjs",
      "require": "./dist/viewer.js"
    }
  },
  "main": "./dist/index.js",
  "jsdelivr": "./dist/index.umd.js",
  "unpkg": "./dist/index.umd.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "locales",
    "async.mjs",
    "async.js",
    "async.d.ts",
    "viewer.mjs",
    "viewer.js",
    "viewer.d.ts"
  ],
  "dependencies": {
    "bytemd": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.1.0",
    "@vue/server-renderer": "3.2.47",
    "vue": "^3.2.47"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  }
}
