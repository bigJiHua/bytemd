{
  "name": "bytemd",
  "version": "1.22.0",
  "description": "Hackable Markdown Editor and Viewer",
  "keywords": [
    "markdown",
    "editor",
    "viewer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bigJiHua/bytemd.git",
    "directory": "packages/bytemd"
  },
  "license": "MIT",
  "author": "Rongjian Zhang",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./svelte/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./processor": {
      "types": "./dist/processor.d.ts",
      "import": "./dist/processor.mjs",
      "require": "./dist/processor.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.mjs",
      "require": "./dist/worker.js"
    },
    "./locales/*": "./locales/*",
    "./lib/locales/*": "./locales/*",
    "./dist/index.css": "./dist/index.css",
    "./dist/index.min.css": "./dist/index.min.css",
    "./dist/markdown.css": "./dist/markdown.css",
    "./dist/markdown.min.css": "./dist/markdown.min.css",
    "./viewer": {
      "types": "./dist/viewer.d.ts",
      "import": "./dist/viewer.mjs",
      "require": "./dist/viewer.js"
    }
  },
  "main": "./dist/index.js",
  "svelte": "./svelte/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "locales",
    "svelte",
    "processor.mjs",
    "processor.js",
    "processor.d.ts",
    "worker.mjs",
    "worker.js",
    "worker.d.ts",
    "viewer.mjs",
    "viewer.js",
    "viewer.d.ts"
  ],
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "github-slugger": "^2.0.0",
    "hast-util-sanitize": "^5.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "select-files": "^1.0.1",
    "tippy.js": "^6.3.7",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vfile": "^6.0.0",
    "word-count": "^0.2.2"
  },
  "devDependencies": {
    "@primer/css": "^15.2.0"
  }
}
